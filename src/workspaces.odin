package pangolin

import "core:fmt"
import "core:os"
import "core:slice"
import "core:strconv"
import "core:strings"

// A workspace is the tool set-up: the tool groups (with their hotkeys, switches, colours,
// patterns and own brush settings) and the shared brush settings. Built-in workspaces are
// generated by code; user workspaces are `<name>.pxws` files in the `workspaces` folder next
// to the executable and can be exported / imported anywhere.

WS_MAX :: 32
WS_EXT :: ".pxws"

Ws_Entry :: struct {
	name:    string,
	path:    string, // saved workspaces only
	builtin: int, // index into WS_BUILTIN_NAMES, or -1 for a saved workspace
}

WS_BUILTIN_NAMES := [?]string{"Default", "Animation", "Tiles", "Shading"}

ws_entries: [dynamic]Ws_Entry
ws_current: string // name of the workspace applied last (not remembered between runs)

FILTERS_WS := [?]Filter{{"Pangolin Pixels workspace (*.pxws)", "*.pxws"}, {"All files", "*.*"}}

// ---------------------------------------------------------------------------
// Serialization
// ---------------------------------------------------------------------------

workspace_text :: proc() -> string {
	groups := tool_groups_serialize() // stores the live brush settings first
	b := shared_brush
	sb := strings.builder_make(context.temp_allocator)
	fmt.sbprintf(&sb, "pxws=1\n")
	fmt.sbprintf(&sb, "brush=%d,%d,%d,%d,%d,%d,%d\n", b.size, int(b.round), int(b.pixel_perf), int(b.fill), int(b.pattern), int(b.ink), b.spray_dens)
	fmt.sbprintf(&sb, "groups=%s\n", groups)
	return strings.to_string(sb)
}

// Applies workspace text; false (and nothing changed) if it holds no tool groups.
workspace_apply_text :: proc(text: string) -> bool {
	if !strings.contains(text, "groups=") {
		return false
	}
	// back to the shared settings first, so the workspace's brush line lands there
	tool_groups_clear()
	rest := text
	for line in strings.split_lines_iterator(&rest) {
		eq := strings.index_byte(line, '=')
		if eq < 0 do continue
		key, val := strings.trim_space(line[:eq]), strings.trim_space(line[eq + 1:])
		switch key {
		case "groups":
			tool_groups_parse(val)
		case "brush":
			v := [7]int{1, 0, 0, 0, 0, 0, 30}
			for ns, j in strings.split(val, ",", context.temp_allocator) {
				if j < len(v) do v[j], _ = strconv.parse_int(ns)
			}
			brush_put({clamp(v[0], 1, 64), v[1] != 0, v[2] != 0, v[3] != 0, Pattern(clamp(v[4], 0, len(Pattern) - 1)), Ink(clamp(v[5], 0, len(Ink) - 1)), clamp(v[6], 1, 100)})
		}
	}
	group_key_wait = -1
	workspace_pick_first_tool()
	return true
}

@(private = "file")
workspace_pick_first_tool :: proc() {
	for &g, gi in tool_groups {
		for t in g.tools {
			if !tool_is_toggle(t) {
				select_tool_in_group(t, gi)
				return
			}
		}
	}
}

// ---------------------------------------------------------------------------
// Built-in workspaces
// ---------------------------------------------------------------------------

@(private = "file")
ws_group :: proc(name: string, key: KeyboardKey, tools: ..Tool) -> ^Tool_Group {
	g := Tool_Group {
		key = key,
	}
	name_set(&g.name, name)
	append(&g.tools, ..tools)
	for t in tools {
		if !tool_is_toggle(t) {
			g.last = t
			break
		}
	}
	append(&tool_groups, g)
	return &tool_groups[len(tool_groups) - 1]
}

@(private = "file")
ws_patterns :: proc(name: string, key: KeyboardKey, patterns: ..Pattern) {
	g := Tool_Group {
		key = key,
	}
	name_set(&g.name, name)
	append(&g.patterns, ..patterns)
	append(&tool_groups, g)
}

workspace_builtin :: proc(i: int) {
	tool_groups_clear()
	brush_put({size = 1, spray_dens = 30})
	switch i {
	case 0:
		tool_groups_default()
	case 1:
		// frame by frame: draw, clean up, flip through frames with the onion skin
		ws_group("Draw", .ONE, .Pencil, .Eraser, .Picker, .Bucket)
		ws_group("Shapes", .TWO, .Line, .Rect, .Ellipse, .Curve)
		ws_group("Select", .THREE, .Select_Rect, .Lasso, .Move)
		ws_group("View", .FOUR, .Hand, .Zoom, .Onion)
	case 2:
		// tile sets: grid-aligned selections and moves, seamless tiling preview
		ws_group("Draw", .ONE, .Pencil, .Eraser, .Picker, .Bucket)
		ws_group("Select", .TWO, .Select_Rect, .Wand, .Move)
		ws_group("Tiles", .THREE, .Grid, .Tiling, .Symmetry)
		ws_group("View", .FOUR, .Hand, .Zoom)
		opts.snap = true
	case 3:
		// shading: a fine pixel-perfect pencil, a bigger brush with its own settings, dither patterns
		pen := ws_group("Line Art", .ONE, .Pencil, .Eraser, .Picker)
		pen.own, pen.brush = true, {size = 1, pixel_perf = true, spray_dens = 30}
		fill := ws_group("Shade", .TWO, .Spray, .Bucket, .Rect)
		fill.own, fill.brush = true, {size = 3, round = true, fill = true, spray_dens = 40}
		ws_patterns("Dither", .THREE, .Checker, .Checker_Inv, .Dither_FgBg, .Dots)
		ws_group("View", .FOUR, .Move, .Hand, .Zoom)
	}
	group_key_wait = -1
	workspace_pick_first_tool()
}

// ---------------------------------------------------------------------------
// Saved workspaces
// ---------------------------------------------------------------------------

ws_dir :: proc() -> string {
	return fmt.tprintf("%sworkspaces/", gfx_app_dir())
}

ws_path_for :: proc(name: string) -> string {
	return fmt.tprintf("%s%s%s", ws_dir(), name, WS_EXT)
}

// Strips characters that cannot go in a file name.
ws_clean_name :: proc(s: string) -> string {
	sb := strings.builder_make(context.temp_allocator)
	for r in strings.trim_space(s) {
		switch r {
		case '\\', '/', ':', '*', '?', '"', '<', '>', '|':
		case:
			strings.write_rune(&sb, r)
		}
	}
	return strings.trim_space(strings.to_string(sb))
}

ws_refresh :: proc() {
	for e in ws_entries {
		delete(e.name)
		delete(e.path)
	}
	clear(&ws_entries)
	for n, i in WS_BUILTIN_NAMES {
		append(&ws_entries, Ws_Entry{name = strings.clone(n), builtin = i})
	}
	files, err := os.read_directory_by_path(ws_dir(), -1, context.temp_allocator)
	if err != nil {
		return
	}
	saved := make([dynamic]Ws_Entry, context.temp_allocator)
	for f in files {
		if f.type == .Directory || lower_ext(f.name) != WS_EXT do continue
		append(&saved, Ws_Entry{name = strings.clone(path_stem(f.name)), path = strings.clone(f.fullpath), builtin = -1})
	}
	slice.sort_by(saved[:], proc(a, b: Ws_Entry) -> bool {
		return strings.compare(strings.to_lower(a.name, context.temp_allocator), strings.to_lower(b.name, context.temp_allocator)) < 0
	})
	for e in saved {
		if len(ws_entries) >= WS_MAX do break
		append(&ws_entries, e)
	}
}

workspace_apply_index :: proc(i: int) {
	if i < 0 || i >= len(ws_entries) do return
	e := ws_entries[i]
	if e.builtin >= 0 {
		workspace_builtin(e.builtin)
	} else {
		data, ok := read_file(e.path)
		if !ok {
			show_message("Workspace", fmt.tprintf("Cannot read %s", path_basename(e.path)))
			return
		}
		defer delete(data)
		if !workspace_apply_text(string(data)) {
			show_message("Workspace", "This is not a valid workspace file.")
			return
		}
	}
	delete(ws_current)
	ws_current = strings.clone(e.name)
	set_statusf("Workspace: %s", e.name)
}

// Saves the current set-up under `name` in the workspaces folder.
workspace_save_named :: proc(name: string) -> bool {
	n := ws_clean_name(name)
	if n == "" {
		set_status("Enter a name for the workspace")
		return false
	}
	os.make_directory_all(ws_dir())
	if !write_file(ws_path_for(n), transmute([]u8)workspace_text()) {
		show_message("Workspace", "Could not write the workspace file.")
		return false
	}
	delete(ws_current)
	ws_current = strings.clone(n)
	set_statusf("Saved workspace %s", n)
	return true
}

workspace_delete_index :: proc(i: int) {
	if i < 0 || i >= len(ws_entries) || ws_entries[i].builtin >= 0 do return
	os.remove(ws_entries[i].path)
	set_statusf("Deleted workspace %s", ws_entries[i].name)
}

workspace_export :: proc() {
	os.make_directory_all(ws_dir())
	initial := fmt.tprintf("%s%s%s", ws_dir(), ws_current != "" ? ws_current : "workspace", WS_EXT)
	p, ok := native_dialog(true, "Export workspace", FILTERS_WS[:], "pxws", initial)
	if !ok do return
	defer delete(p)
	if write_file(p, transmute([]u8)workspace_text()) {
		set_statusf("Exported workspace to %s", path_basename(p))
	} else {
		show_message("Workspace", "Could not write the workspace file.")
	}
}

// Loads a workspace file, applies it and keeps a copy in the workspaces folder.
workspace_import :: proc() {
	p, ok := native_dialog(false, "Import workspace", FILTERS_WS[:], "pxws", "")
	if !ok do return
	defer delete(p)
	data, rok := read_file(p)
	if !rok {
		show_message("Workspace", fmt.tprintf("Cannot read %s", path_basename(p)))
		return
	}
	defer delete(data)
	if !workspace_apply_text(string(data)) {
		show_message("Workspace", "This is not a valid workspace file.")
		return
	}
	name := ws_clean_name(path_stem(p))
	if name != "" {
		os.make_directory_all(ws_dir())
		write_file(ws_path_for(name), data)
		delete(ws_current)
		ws_current = strings.clone(name)
	}
	set_statusf("Imported workspace %s", path_basename(p))
}

// ---------------------------------------------------------------------------
// Dialog
// ---------------------------------------------------------------------------

dlg_workspaces :: proc() {
	c := dialog_frame("Workspaces", 320, 150)
	y := c.y
	@(static) names: [WS_MAX]string
	n := len(ws_entries)
	for e, i in ws_entries do names[i] = e.name
	dialog.a = clamp(dialog.a, 0, n - 1)
	PICK_TIP :: "Choose a workspace to load or delete. A workspace is a whole tool set-up: the groups, their hotkeys and the brush settings."
	tip_text(c.x, y + 3, "Workspace", C_TEXT, {"Workspace", PICK_TIP})
	if nv, ch := combo(Rect{c.x + 80, y, c.w - 80, 14}, names[:n], dialog.a, {"Workspace", PICK_TIP}); ch {
		dialog.a = nv
	}
	y += 22
	if button(Rect{c.x, y, 60, 16}, "Load", {"Load", "Switch to the selected workspace. Your current tool groups are replaced, so save them first if you want to keep them."}) {
		workspace_apply_index(dialog.a)
	}
	saved := ws_entries[dialog.a].builtin < 0
	if button(Rect{c.x + 66, y, 60, 16}, "Delete", {"Delete", "Delete the selected workspace's file. The built-in workspaces can't be deleted."}, saved) {
		workspace_delete_index(dialog.a)
		ws_refresh()
	}
	y += 24
	SAVE_NAME_TIP :: Tip{"Save as", "The name to save the current tool set-up under."}
	tip_text(c.x, y + 3, "Save as", C_TEXT, SAVE_NAME_TIP)
	text_field(Rect{c.x + 80, y, c.w - 80 - 66, 14}, &dialog.name, SAVE_NAME_TIP)
	if button(Rect{c.x + c.w - 60, y - 1, 60, 16}, "Save", {"Save", "Save the current tool set-up as a workspace under the name on the left. A workspace with that name is replaced."}) {
		if workspace_save_named(name_str(&dialog.name)) {
			ws_refresh()
			for e, i in ws_entries {
				if e.builtin < 0 && e.name == ws_current do dialog.a = i
			}
		}
	}
	y += 24
	if button(Rect{c.x, y, 80, 16}, "Import...", {"Import", cmd_help(.Ws_Import)}) {
		workspace_import()
		ws_refresh()
	}
	if button(Rect{c.x + 86, y, 80, 16}, "Export...", {"Export", cmd_help(.Ws_Export)}) {
		workspace_export()
	}
	ok, _ := dialog_buttons(c, "Close this window (Enter or Esc).", "Close", "")
	if ok {
		dialog_close()
	}
}
